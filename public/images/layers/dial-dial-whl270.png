    <circle cx="250" cy="250" r="114" fill="none" stroke="#c4c4c4" stroke-width="0.5" stroke-dasharray="1 5.97" />
    <line x1="250.0" y1="138.0" x2="250.0" y2="154.0" stroke="#111111" stroke-width="4" stroke-linecap="square" />
