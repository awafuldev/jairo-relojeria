<line x1="153.0" y1="306.0" x2="161.7" y2="301.0" stroke="#111111" stroke-width="2" stroke-linecap="square" />
<line x1="138.0" y1="250.0" x2="154.0" y2="250.0" stroke="#111111" stroke-width="4" stroke-linecap="square" />
<line x1="153.0" y1="194.0" x2="161.7" y2="199.0" stroke="#111111" stroke-width="2" stroke-linecap="square" />
<line x1="194.0" y1="153.0" x2="199.0" y2="161.7" stroke="#111111" stroke-width="2" stroke-linecap="square" />

    <!-- Center pinion -->
    <circle cx="250" cy="250" r="6" fill="#121212" stroke="#111111" stroke-width="1" />
  
</svg>